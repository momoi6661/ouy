# —— 模型（OpenAI 兼容接口）——
AI_MODEL=gpt-4o
AI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
# 接口类型：auto（自动判断，推理模型走 responses，其余走 chat）/ responses / chat
AI_API_MODE=auto

# —— 网络代理（可选，仅支持 http/https 代理；留空则直连）——
LOCAL_PROXY_URL=

# —— 知识库本地向量模型（首次启动自动下载约 90MB；留空则只用关键词检索）——
KB_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# —— 欧易站点：global / eea / us / tr ——
OKX_SITE=global

# —— 服务监听。默认只允许本机访问；改成 0.0.0.0 给局域网/手机用时必须设置 OUY_ACCESS_KEY ——
OUY_HOST=127.0.0.1
PORT=8899
OUY_ACCESS_KEY=
